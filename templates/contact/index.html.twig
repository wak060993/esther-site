{% extends 'base.html.twig' %}
{% block title %}Contact — Esther{% endblock %}
{% block body %}

<section style="padding-top:56px;">
  <div class="wrap" style="max-width:560px;">
    <p class="eyebrow">Contact</p>
    <h1 style="font-size:clamp(1.8rem,5vw,2.4rem);margin:14px 0 28px;">Écrire à Esther</h1>

    {% if envoye %}
      <p style="background:var(--card);border:1px solid var(--line);padding:18px;border-radius:2px;color:var(--forest-deep);">
        Message envoyé, merci ! Esther te répondra dès que possible.
      </p>
    {% else %}
      {% if erreur %}
        <p style="color:#A85C4A;margin-bottom:16px;">{{ erreur }}</p>
      {% endif %}
      <form method="post" style="display:flex;flex-direction:column;gap:16px;">
        <input type="text" name="nom" placeholder="Ton nom" required
               style="padding:14px 16px;border:1px solid var(--line);border-radius:2px;font-family:inherit;font-size:1rem;">
        <input type="email" name="email" placeholder="Ton email" required
               style="padding:14px 16px;border:1px solid var(--line);border-radius:2px;font-family:inherit;font-size:1rem;">
        <textarea name="message" placeholder="Ton message" required rows="6"
                  style="padding:14px 16px;border:1px solid var(--line);border-radius:2px;font-family:inherit;font-size:1rem;resize:vertical;"></textarea>
        <button type="submit" class="btn btn-primary" style="align-self:flex-start;">Envoyer</button>
      </form>
    {% endif %}
  </div>
</section>

{% endblock %}