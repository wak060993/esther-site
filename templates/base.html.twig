<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Esther — Journal & Livres{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1C2B2A;
    --ink-soft:#4B5C59;
    --paper:#E9EAE2;
    --paper-warm:#F1F1EA;
    --card:#FBFAF5;
    --gold:#C9982E;
    --gold-deep:#A87A1E;
    --forest:#3B5D50;
    --forest-deep:#2A443A;
    --line: rgba(28,43,42,0.12);
    --radius: 2px;
    --pad: 20px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Fraunces',serif;
    font-weight:500;
    letter-spacing:-0.01em;
    margin:0;
  }
  a{color:inherit;text-decoration:none;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:0.7rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--forest-deep);
    display:flex;
    align-items:center;
    gap:0.5em;
  }
  .eyebrow::before{
    content:"";
    width:16px;height:1px;
    background:var(--gold-deep);
    display:inline-block;
    flex-shrink:0;
  }
  .wrap{max-width:1120px;margin:0 auto;padding:0 var(--pad);}
  img,svg{display:block;max-width:100%;}
  :focus-visible{outline:2px solid var(--gold-deep);outline-offset:3px;}

  /* ================= HEADER (mobile base) ================= */
  header{
    position:sticky;top:0;z-index:60;
    background:rgba(233,234,226,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px var(--pad);
    max-width:1120px;margin:0 auto;
  }
  .logo{
    font-family:'Fraunces',serif;
    font-size:1.2rem;font-weight:500;
    display:flex;align-items:center;gap:9px;
  }
  .logo .ring{
    width:20px;height:20px;border-radius:50%;
    border:1.5px solid var(--gold-deep);position:relative;flex-shrink:0;
  }
  .logo .ring::after{
    content:"";position:absolute;inset:4px;
    border-radius:50%;border:1.5px solid var(--forest-deep);
  }
  .burger{
    width:44px;height:44px;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:5px;
    background:none;border:none;cursor:pointer;
  }
  .burger span{width:22px;height:1.5px;background:var(--ink);transition:transform .25s ease, opacity .2s ease;}
  .burger.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
  .burger.open span:nth-child(2){opacity:0;}
  .burger.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}

  .mobile-menu{
    max-height:0;overflow:hidden;
    background:var(--paper-warm);
    border-bottom:1px solid var(--line);
    transition:max-height .3s ease;
  }
  .mobile-menu.open{max-height:340px;}
  .mobile-menu ul{list-style:none;margin:0;padding:8px var(--pad) 20px;display:flex;flex-direction:column;}
  .mobile-menu a{padding:14px 4px;font-size:1rem;font-weight:500;border-bottom:1px solid var(--line);}
  .mobile-menu .navcta{margin-top:14px;text-align:center;}

  .navlinks{display:none;}
  .navcta{
    display:none;
    font-size:0.82rem;font-weight:600;
    background:var(--forest-deep);color:var(--paper-warm);
    padding:10px 18px;border-radius:var(--radius);
  }

  /* ================= HERO ================= */
  .hero{position:relative;padding:56px var(--pad) 64px;overflow:hidden;}
  .rings-bg{
    position:absolute; right:-220px; top:-80px;
    width:420px;height:420px;opacity:0.7;pointer-events:none;
  }
  .hero-inner{
    max-width:1120px;margin:0 auto;
    display:flex;flex-direction:column;gap:36px;
  }
  .hero h1{font-size:clamp(1.9rem,7vw,2.2rem);line-height:1.14;}
  .hero h1 em{font-style:italic;color:var(--gold-deep);}
  .hero p.lede{margin-top:18px;font-size:1rem;color:var(--ink-soft);max-width:46ch;}
  .hero-ctas{display:flex;flex-direction:column;gap:12px;margin-top:28px;}
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    padding:15px 24px;border-radius:var(--radius);
    font-weight:600;font-size:0.94rem;min-height:48px;
    border:1px solid transparent;
  }
  .btn-primary{background:var(--forest-deep);color:var(--paper-warm);}
  .btn-ghost{border-color:var(--ink);color:var(--ink);}

  .portrait-frame{
    position:relative;aspect-ratio:4/3;
    background:linear-gradient(150deg, var(--forest-deep), var(--forest) 60%, var(--gold-deep));
    border-radius:var(--radius);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 20px 40px -24px rgba(28,43,42,0.45);
  }
  .portrait-frame .monogram{font-family:'Fraunces',serif;font-size:4rem;color:rgba(251,250,245,0.92);}
  .portrait-tag{
    position:absolute;bottom:-16px;left:16px;right:16px;
    background:var(--card);border:1px solid var(--line);
    padding:12px 16px;border-radius:var(--radius);
    font-family:'JetBrains Mono',monospace;font-size:0.7rem;
    box-shadow:0 12px 24px -12px rgba(0,0,0,0.2);
  }

  /* ================= SECTION SHELL ================= */
  section{padding:56px 0;}
  .section-head{margin-bottom:32px;}
  .section-head h2{font-size:1.55rem;}
  .section-head .desc{margin-top:10px;color:var(--ink-soft);font-size:0.92rem;}

  /* ================= ARTICLES ================= */
  .articles-grid{display:flex;flex-direction:column;gap:20px;}
  .article-card{
    background:var(--card);border:1px solid var(--line);
    border-radius:var(--radius);overflow:hidden;
    display:flex;flex-direction:column;
  }
  .article-thumb{
    height:130px;
    background:repeating-linear-gradient(120deg, var(--forest-deep) 0 2px, transparent 2px 22px), var(--paper-warm);
    position:relative;
  }
  .article-thumb .ring-mark{
    position:absolute;right:14px;bottom:-14px;
    width:38px;height:38px;border-radius:50%;
    border:1.5px solid var(--gold-deep);background:var(--card);
  }
  .article-body{padding:18px 18px 22px;display:flex;flex-direction:column;gap:9px;}
  .article-meta{font-family:'JetBrains Mono',monospace;font-size:0.66rem;color:var(--forest-deep);display:flex;gap:8px;}
  .article-body h3{font-size:1.1rem;line-height:1.32;}
  .article-body p{font-size:0.88rem;color:var(--ink-soft);}
  .read-more{font-size:0.82rem;font-weight:600;color:var(--gold-deep);display:inline-flex;gap:6px;padding:6px 0;}

  /* ================= BOOKS — scroll horizontal sur mobile ================= */
  .books{background:var(--forest-deep);color:var(--paper-warm);padding:44px 0;margin:0 var(--pad);border-radius:var(--radius);}
  .books .wrap-inner{padding:0 var(--pad);}
  .books .section-head h2{color:var(--paper-warm);}
  .books .section-head .desc{color:rgba(241,241,234,0.72);}
  .books-scroller{
    display:flex;gap:18px;overflow-x:auto;padding-bottom:8px;
    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    margin:0 calc(var(--pad) * -1) 0 0;
  }
  .book{flex:0 0 150px;scroll-snap-align:start;display:flex;flex-direction:column;gap:12px;}
  .book-cover{
    aspect-ratio:2/3;border-radius:1px;
    background:linear-gradient(160deg, var(--gold) 0%, var(--gold-deep) 100%);
    display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;
    border:1px solid rgba(251,250,245,0.15);
  }
  .book-cover span{font-family:'Fraunces',serif;font-size:0.92rem;color:var(--forest-deep);line-height:1.25;}
  .book h4{font-family:'Fraunces',serif;font-weight:500;font-size:0.92rem;}
  .book .link-out{font-family:'JetBrains Mono',monospace;font-size:0.66rem;color:var(--gold);display:flex;gap:5px;}

  /* ================= PILLARS ================= */
  .pillars{display:flex;flex-direction:column;gap:1px;background:var(--line);border:1px solid var(--line);}
  .pillar{background:var(--paper-warm);padding:32px 24px;}
  .pillar .ring-num{
    width:48px;height:48px;border-radius:50%;border:1.5px solid var(--gold-deep);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--forest-deep);
    margin-bottom:18px;position:relative;
  }
  .pillar .ring-num::before{content:"";position:absolute;inset:8px;border-radius:50%;border:1px solid var(--forest);}
  .pillar h3{font-size:1.18rem;margin-bottom:10px;}
  .pillar p{color:var(--ink-soft);font-size:0.9rem;}
  .pillar .lien{margin-top:16px;display:inline-block;font-size:0.82rem;font-weight:600;color:var(--gold-deep);}

  /* ================= ABOUT ================= */
  .about{display:flex;flex-direction:column;gap:32px;}
  .about-frame{
    aspect-ratio:16/10;border-radius:var(--radius);
    background:radial-gradient(circle at 30% 30%, var(--paper-warm), var(--paper) 70%);
    border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
  }
  .about-frame svg{width:40%;}
  .about blockquote{font-family:'Fraunces',serif;font-style:italic;font-size:1.28rem;margin:0 0 16px;line-height:1.4;}
  .about p{color:var(--ink-soft);font-size:0.94rem;}

  /* ================= NEWSLETTER ================= */
  .newsletter{background:var(--ink);color:var(--paper-warm);border-radius:var(--radius);padding:44px var(--pad);margin:0 var(--pad);text-align:center;}
  .newsletter h2{color:var(--paper-warm);font-size:1.45rem;margin-bottom:12px;}
  .newsletter p{color:rgba(241,241,234,0.7);margin:0 auto 26px;font-size:0.92rem;}
  .nl-form{display:flex;flex-direction:column;gap:12px;}
  .nl-form input{
    padding:15px 16px;border:1px solid rgba(241,241,234,0.3);
    background:transparent;color:var(--paper-warm);border-radius:var(--radius);
    font-family:inherit;font-size:1rem; /* évite le zoom iOS */
  }
  .nl-form input::placeholder{color:rgba(241,241,234,0.5);}
  .nl-form button{
    background:var(--gold);color:var(--forest-deep);border:none;
    padding:15px 22px;border-radius:var(--radius);font-weight:700;cursor:pointer;font-size:1rem;
  }

  /* ================= FOOTER ================= */
  footer{border-top:1px solid var(--line);padding:44px 0 28px;}
  .footer-grid{display:flex;flex-direction:column;gap:32px;margin-bottom:36px;}
  .footer-grid h5{font-family:'JetBrains Mono',monospace;font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--forest-deep);margin-bottom:14px;}
  .footer-grid ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;}
  .footer-grid a{font-size:0.9rem;color:var(--ink-soft);display:inline-block;padding:4px 0;}
  .footer-bottom{display:flex;flex-direction:column;gap:14px;border-top:1px solid var(--line);padding-top:20px;font-size:0.76rem;color:var(--ink-soft);}
  .socials{display:flex;gap:18px;}

  /* ================================================================
     DESKTOP ENHANCEMENTS (min-width: 900px) — mobile styles au-dessus
     restent la base, on enrichit ici pour les grands écrans
     ================================================================ */
  @media (min-width:900px){
    :root{--pad:32px;}
    .burger,.mobile-menu{display:none;}
    .navlinks{display:flex;gap:34px;font-size:0.88rem;font-weight:500;}
    .navlinks a{opacity:0.75;transition:opacity .2s;}
    .navlinks a:hover{opacity:1;}
    .navcta{display:inline-flex;}
    .logo{font-size:1.35rem;}

    .hero{padding:100px var(--pad) 120px;}
    .rings-bg{right:-160px;top:50%;transform:translateY(-50%);width:640px;height:640px;opacity:0.9;}
    .hero-inner{display:grid;grid-template-columns:1.1fr 0.9fr;gap:60px;align-items:center;}
    .hero h1{font-size:clamp(2.4rem,4.4vw,3.6rem);max-width:11.5ch;}
    .hero p.lede{font-size:1.08rem;}
    .hero-ctas{flex-direction:row;flex-wrap:wrap;}
    .btn{width:auto;}
    .btn:hover{transform:translateY(-2px);}
    .btn-primary:hover{background:var(--forest);}
    .btn-ghost:hover{background:var(--ink);color:var(--paper-warm);}
    .portrait-frame{aspect-ratio:4/5;}
    .portrait-frame .monogram{font-size:5.5rem;}
    .portrait-tag{left:-18px;right:auto;bottom:-18px;max-width:220px;}

    section{padding:96px 0;}
    .section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:48px;}
    .section-head h2{font-size:2rem;max-width:16ch;}
    .section-head .desc{max-width:40ch;font-size:0.95rem;margin-top:0;}

    .articles-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
    .article-card{transition:transform .2s ease, box-shadow .2s ease;}
    .article-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px -24px rgba(28,43,42,0.35);}
    .article-thumb{height:150px;}

    .books{padding:72px 48px;}
    .books-scroller{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible;margin:0;}
    .book{flex:none;}

    .pillars{display:grid;grid-template-columns:repeat(3,1fr);}
    .pillar{padding:44px 36px;}

    .about{display:grid;grid-template-columns:0.8fr 1.2fr;gap:60px;align-items:center;}
    .about-frame{aspect-ratio:1/1;}
    .about-frame svg{width:70%;}
    .about blockquote{font-size:1.5rem;}
    .about p{max-width:52ch;}

    .newsletter{padding:64px 48px;}
    .newsletter h2{font-size:1.8rem;}
    .newsletter p{max-width:44ch;font-size:1rem;}
    .nl-form{flex-direction:row;max-width:440px;margin:0 auto;}
    .nl-form input{flex:1;}

    .footer-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:40px;}
    .footer-bottom{flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:wrap;}
  }
</style>
</head>
<body>

<header>
  <div class="nav">
    <a href="{{ path('app_home') }}" class="logo"><span class="ring"></span> Esther</a>
    <nav class="navlinks">
      <a href="{{ path('app_home') }}">Accueil</a>
      <a href="{{ path('app_journal_index') }}">Journal</a>
      <a href="{{ path('app_livre_index') }}">Livres</a>
      <a href="{{ path('app_page_apropos') }}">À propos</a>
    </nav>
    <a class="navcta" href="{{ path('app_home') }}#newsletter">Recevoir le journal</a>
    <button class="burger" id="burgerBtn" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <ul>
      <li><a href="{{ path('app_home') }}">Accueil</a></li>
      <li><a href="{{ path('app_journal_index') }}">Journal</a></li>
      <li><a href="{{ path('app_livre_index') }}">Livres</a></li>
      <li><a href="{{ path('app_page_apropos') }}">À propos</a></li>
    </ul>
  </div>
</header>

{% block body %}{% endblock %}

<section id="newsletter">
  <div class="newsletter wrap">
    <h2>Un mot chaque dimanche</h2>
    <p>Le nouvel article, une pensée courte et parfois un extrait en avant-première.</p>
    <form class="nl-form" id="newsletterForm">
      <input type="email" name="email" placeholder="Votre adresse email" required>
      <button type="submit">S'inscrire</button>
    </form>
    <p id="newsletterMsg" style="margin-top:14px;font-size:0.85rem;"></p>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="logo"><span class="ring"></span> Esther</div>
        <p style="color:var(--ink-soft);font-size:0.88rem;margin-top:14px;max-width:32ch;">Un journal de développement personnel, nourri d'expérience vécue et de livres écrits pour accompagner.</p>
      </div>
      <div>
        <h5>Le site</h5>
        <ul>
          <li><a href="{{ path('app_home') }}">Accueil</a></li>
          <li><a href="{{ path('app_journal_index') }}">Journal</a></li>
          <li><a href="{{ path('app_livre_index') }}">Livres</a></li>
          <li><a href="{{ path('app_page_apropos') }}">À propos</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ "now"|date("Y") }} Esther — Tous droits réservés</span>
    </div>
  </div>
</footer>

<script>
  const burgerBtn = document.getElementById('burgerBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  burgerBtn.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('open');
    burgerBtn.classList.toggle('open', isOpen);
  });

  document.getElementById('newsletterForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = e.target.email.value;
    const res = await fetch("{{ path('app_newsletter_inscription') }}", {
      method: 'POST',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'email=' + encodeURIComponent(email)
    });
    const data = await res.json();
    document.getElementById('newsletterMsg').textContent = data.message;
    if (data.success) e.target.reset();
  });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>